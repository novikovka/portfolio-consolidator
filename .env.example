# Образец настроек. Скопируйте этот файл в .env и впишите свой пароль:
#   copy .env.example .env
# Файл .env не попадает в GitHub (он указан в .gitignore).
# Пароль лучше придумать из латинских букв и цифр.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=portfolio
DB_USER=portfolio_app
DB_PASSWORD=change_me

# Порт приложения на сервере (docker compose --profile app). Обычно менять не нужно.
APP_PORT=8501
